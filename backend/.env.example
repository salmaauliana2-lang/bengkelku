APP_PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/workshop_db?sslmode=disable
# Wajib minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Origin frontend yang diizinkan, dipisah koma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Isi data demo (56 spare part + transaksi 7 hari) saat database kosong.
# Set false jika ingin memulai tanpa data contoh.
SEED_DEMO_DATA=true
